VITE_AMPLITUDE_API_KEY=YOUR_API_KEY
# Optional: set to `true` to send events in `npm run dev` as well.
VITE_AMPLITUDE_DEV_ENABLED=false

# Optional: base URL of the read-only API. LEAVE THIS UNSET unless you are
# working on the backend migration.
#
# Unset, the app loads every entity from the TSV files in public/data, which is
# what it has always done and what production still does. You need no database.
#
# Set, territories are loaded from the API instead - one request replacing five
# files. Nothing else has moved yet. Requires a local PostgreSQL and PostgREST;
# see backend/README.md.
#
# VITE_API_URL=http://localhost:3000

# Supabase's anonymous key. Not needed against a bare local PostgREST.
# This key is public by design - it ships inside the built JavaScript. What
# actually limits a caller is the anon role's grants and the row level security
# policies in backend/schema/006_rls.sql.
# NEVER put a service-role key here: it bypasses RLS entirely.
# VITE_API_KEY=eyJ...
