# lang-nav backend - connection settings
#
# Copy to `.env` and fill in the passwords. `.env` is gitignored.
# Nothing in this file is read by the frontend; it is used only by the
# Python ETL and by scripts/bootstrap_database.py.

# ---------------------------------------------------------------------------
# Bootstrap connection - used ONCE by scripts/bootstrap_database.py to create
# the database and the application role. Needs CREATEDB + CREATEROLE, so this
# is normally the `postgres` superuser.
#
# The bootstrap script connects to the `postgres` maintenance database and
# will refuse to operate on any database other than LANGNAV_DB below.
# ---------------------------------------------------------------------------
PGHOST=localhost
PGPORT=5432
BOOTSTRAP_USER=postgres
BOOTSTRAP_PASSWORD=
BOOTSTRAP_DB=postgres

# ---------------------------------------------------------------------------
# Application connection - what the ETL uses for every subsequent run.
# Created by the bootstrap script; owns the langnav database and nothing else.
# ---------------------------------------------------------------------------
LANGNAV_DB=langnav
LANGNAV_USER=langnav_etl
LANGNAV_PASSWORD=

# ---------------------------------------------------------------------------
# Read-only API connection - used by PostgREST, and only if you want the API.
# Leave blank to skip: the ETL never reads this, and schema/005_roles.sql skips
# its grants with a notice when the roles do not exist.
#
# Invent a new password. The role it belongs to is NOINHERIT and owns nothing,
# so it can read nothing at all until it assumes langnav_read - which is what
# makes this credential far less dangerous than LANGNAV_PASSWORD above.
#
# The role NAMES are fixed (langnav_read, langnav_authenticator) rather than
# configurable here, because schema/005_roles.sql grants to them by name and a
# .sql file cannot read this file.
#
# Create the roles with:
#   python scripts/bootstrap_database.py --api-roles --apply
# ---------------------------------------------------------------------------
LANGNAV_AUTHENTICATOR_PASSWORD=

# Which browser origins may call the API. Comma-separated, no spaces.
# Defaults to this project's own local servers: 5173 is `npm run dev`, 4173 is
# `npm run preview`. A DEPLOYMENT MUST SET THIS to the real site origin -
# leaving it empty makes PostgREST allow any origin at all.
# LANGNAV_API_CORS_ORIGINS=https://lang-nav.example

# Backstop against a runaway query. NOT a page size, and read the comment in
# scripts/write_postgrest_config.py before lowering it: a capped response is
# indistinguishable from a complete one to the frontend, so a cap that can
# actually be reached would silently truncate the data. The default is above
# the largest table (`locale`, 55,322 rows) on purpose.
# LANGNAV_API_MAX_ROWS=100000

# Port PostgREST listens on. Change both this and VITE_API_URL together.
# LANGNAV_API_PORT=3000

# ---------------------------------------------------------------------------
# How long a single statement may run. Raised for the loading session by
# etl/db.py, because several derive steps are single statements that take
# minutes - rebuild_family_locales for Glottolog builds 16,836 rows in one call
# and took over 7 minutes on Supabase's free tier.
#
# A local PostgreSQL has no limit by default, so this changes nothing there.
# Supabase enforces 2 minutes on the database, which killed the first load
# after every COPY had already succeeded.
#
# Bounded rather than disabled on purpose: a runaway statement should fail
# eventually instead of holding locks forever.
# ---------------------------------------------------------------------------
# LANGNAV_STATEMENT_TIMEOUT=30min

# ---------------------------------------------------------------------------
# Where the TSV source files live, relative to the repository root.
# ---------------------------------------------------------------------------
DATA_ROOT=public/data
